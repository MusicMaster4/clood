{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clood",
  "version": "0.1.0",
  "identifier": "dev.slop.clood",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Clood",
        "width": 920,
        "height": 640,
        "minWidth": 680,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDN0NDNTcxNkYxQTI0NjkKUldScEpCcHZjY1Y4WEZDKzMzd0cwSDFxYzBWblV1WDVqdjAvNWxHTE1LZDRPaFRFMnZoNFVUd0UK",
      "endpoints": [
        "https://github.com/MusicMaster4/clood/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
